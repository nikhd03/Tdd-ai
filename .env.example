# Base URL of your VM server (ngrok), no trailing slash
NEXT_PUBLIC_VM_API_URL=https://cardstock-driller-grumbly.ngrok-free.dev

# Where videos are POSTed (multipart/form-data). Usually your n8n Webhook *production* URL.
NEXT_PUBLIC_UPLOAD_ENDPOINT=https://your-n8n-host/webhook/upload-test-video

# Optional: multipart field name for the video (n8n Webhook "Field Name for Binary Data" -> default 'file')
NEXT_PUBLIC_UPLOAD_FIELD_NAME=file

# Optional: client-side upload size limit in MB
NEXT_PUBLIC_MAX_UPLOAD_MB=500

# Used by the VM server only (see vm-server/.env.example); listed here for reference
TESTS_DIR=./generated-tests
